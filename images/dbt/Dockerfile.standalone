
FROM python:3.12-slim

# Création de l'utilisateur non-root
RUN useradd --create-home --uid 1000 app

# Répertoires de travail et de sortie
WORKDIR /app
RUN mkdir -p /output \
    && chown -R app:app /app /output

# Installation de dbt et de son adaptateur DuckDB
RUN pip install --no-cache-dir \
    dbt-core==1.12.7 \
    dbt-duckdb==1.11.1

# Copie du projet dbt
COPY --chown=app:app . .

# Configuration du profil dbt
ENV DBT_PROFILES_DIR=/app

# Exécution avec un utilisateur non-root
USER app

CMD ["dbt", "build"]
